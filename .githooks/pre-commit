#!/bin/sh
# Blocks a commit if it contains secrets or any of your private terms.
# Turn it on once per clone:  git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Install it (Windows: winget install Gitleaks.Gitleaks), then commit again." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner || {
  echo "pre-commit: gitleaks found a possible secret. Remove it before committing." >&2
  exit 1
}

# Optional private word list: one name, email or term per line. It lives in
# .git/info/private-terms, so it is never committed or pushed.
terms="$(git rev-parse --git-common-dir)/info/private-terms"
if [ -s "$terms" ]; then
  hits=$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | grep -iwF -f "$terms")
  if [ -n "$hits" ]; then
    echo "pre-commit: these added lines contain a private term:" >&2
    echo "$hits" >&2
    exit 1
  fi
fi
